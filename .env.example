# ============================================
# AXELR AI MASTER ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your actual values
# ============================================

# ── Core Environment ────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
PORT=8000

# ── JWT Security ─────────────────────────────────────────────────────────────
JWT_SECRET=your-secure-jwt-secret-min-32-chars

# ── Admin & Authentication ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NETLIFY_ACCESS_TOKEN=

# ── Database & Storage ──────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://your-mongodb-uri
DATA_WORKER_URL=
REDIS_URL=redis://localhost:6379/0

# ── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=axelr-uploads

# ── AI Provider API Keys ────────────────────────────────────────────────────
GROQ_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
NROUTER_API_KEY=
TEXT_CORTEX_API_KEY=
NARAROUTER_API_KEY=
BAZAARLINK_API_KEY=
SILICONFLOW_API_KEY=
AGNES_API_KEY=
OLLAMA_API_KEY=
ANYAPI_API_KEY=
MODELSCOPE_API_KEY=
OVHCLOUD_API_KEY=
REQUESTY_API_KEY=
MANIFEST_API_KEY=
GLAMA_API_KEY=
ZAI_API_KEY=
TEAMOROUTER_API_KEY=
ZHIPU_API_KEY=

# ── Cloudflare R2 & KV ──────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=axelr-pocketbase
CLOUDFLARE_KV_NAMESPACE_ID=

# ── GitHub OAuth ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://axelr-backend.onrender.com/api/auth/github/callback

# ── WebAuthn ────────────────────────────────────────────────────────────────
RP_ID=axelr.in
RP_NAME=AXELR AI
ORIGIN=https://axelr.in

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_INTENT_CLASSIFIER=true
ENABLE_CONTEXT_REGISTRY=true
ENABLE_CRITIC=true
ENABLE_SELF_HEAL=true
ENABLE_BLAST_RADIUS=false
ENABLE_PR_DEFENSE=true
WORKSPACE_ROOT=

# Hot Swap Engine Flags
ENABLE_HOT_SWAP=true
ENABLE_TWIN_TELEMETRY=true
ENABLE_TWIN_PREWARM=true
ENABLE_OVERRIDE_TIMER=true
ENABLE_MICRO_VOLATILE=true

# ── Model Configuration ──────────────────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODELS=llama3-70b-8192,mixtral-8x7b-32768,gemma2-9b-it
OPENROUTER_MODELS=openrouter/auto,mistralai/mistral-7b-instruct:free,deepseek/deepseek-chat:free
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
MODELSCOPE_MODELS=qwen-max,deepseek-v3
OLLAMA_MODELS=mistral-large-3:675b-cloud,kimi-k2.6,glm-5.3
NARA_MODELS=minimax-m3,deepseek-v3
MISTRAL_MODELS=open-mistral-7b,mistral-small-latest
HUGGINGFACE_MODELS=meta-llama/Llama-3.2-3B-Instruct,mistralai/Mistral-7B-Instruct-v0.3
GITHUB_MODEL=gpt-4o-mini
OVHCLOUD_MODELS=llama-3.3-70b-instruct,mistral-7b-instruct
SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3,Qwen/Qwen2.5-7B-Instruct
AGNES_MODEL=agnes-2.0-flash
ZHIPU_MODEL=glm-4.5-flash
TEAMOROUTER_MODEL=teamorouter-free
BAZAARLINK_MODEL=auto:free
REQUESTY_MODEL=auto:free
NROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
GLAMA_MODEL=gpt-3.5-turbo
FREE_TIER_TOKEN_LIMIT=1000000

# ── PayPal Payment Processing ────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id-here
PAYPAL_WEBHOOK_SECRET=

# ── Nebius & Vultr ──────────────────────────────────────────────────────────
NEBIUS_API_KEY=
NEBIUS_MODELS=llama3-70b-instruct,mistral-large-2
VULTR_API_KEY=
VULTR_API_BASE=https://api.vultr.com/v2

# ── Upstash QStash ──────────────────────────────────────────────────────────
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=
UPSTASH_QSTASH_NEXT_SIGNING_KEY=

# ── HTTP Client Configuration ──────────────────────────────────────────────
HTTP_MAX_CONNECTIONS=2
HTTP_MAX_KEEPALIVE=2

# ── Apex Router (Local Demo) ────────────────────────────────────────────────
NAS_ROOT=/tmp/axelr-demo
APEX_ROUTER_ENDPOINT=http://127.0.0.1:11434
APEX_ROUTER_MODEL=gemma3:4b
APEX_ROUTER_TIMEOUT_S=90
APEX_ROUTER_MAX_RETRIES=2
AXELR_DEBOUNCE_S=2.0
AXELR_MAX_TEXT_CHARS=8000
AXELR_UNDO_LOG_SIZE=50
AXELR_ALLOWED_EXT=.pdf,.eml,.txt,.md,.png,.jpg,.jpeg
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=/var/lib/ollama/models
OLLAMA_KEEP_ALIVE=5m

# ── Pydantic Logfire ────────────────────────────────────────────────────────
LOGFIRE_TOKEN=