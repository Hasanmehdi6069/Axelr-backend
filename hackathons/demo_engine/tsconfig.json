{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./hackathons/demo.engine",
    "rootDir": "./hackathons/demo.engine",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["hackathons/demo.engine/*.ts"],
  "exclude": ["node_modules"]
}