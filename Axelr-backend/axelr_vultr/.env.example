# ── Vultr (required) ─────────────────────────────────────────────────────────
VULTR_API_KEY=your_vultr_api_key_here

# ── Vultr API (optional — defaults are fine) ────────────────────────────────
VULTR_API_URL=https://api.vultr.com/v2
VULTR_TIMEOUT_S=20
VULTR_MAX_RETRIES=3
VULTR_RATE_LIMIT_PER_MIN=480

# ── Defaults ────────────────────────────────────────────────────────────────
VULTR_DEFAULT_REGION=ewr

# ── Safety guards (elite) ───────────────────────────────────────────────────
VULTR_MONTHLY_BUDGET_USD=50
VULTR_DAILY_PROVISION_LIMIT=10
VULTR_DESTROY_GRACE_S=0
VULTR_WAIT_MAX_S=240

# ── Testing ─────────────────────────────────────────────────────────────────
VULTR_DRY_RUN=0          # set 1 to test flows without spending
VULTR_E2E=0              # set 1 to enable destructive verification

# ── Parent app (for auditing bridge) ────────────────────────────────────────
AXELR_BASE_URL=http://127.0.0.1:8000
AXELR_TOKEN=