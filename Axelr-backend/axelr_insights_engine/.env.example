# ── Storage backend: "mongo" or "appwrite" ────────────────────────────
INSIGHTS_STORAGE_BACKEND=mongo

# ── MongoDB (required when storage_backend=mongo) ─────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=axelr

# ── Appwrite (required when storage_backend=appwrite) ────────────────
# Replace <region> with your Appwrite cloud region.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ae1afe6001b9861b562
APPWRITE_API_KEY=standard_9ba08dfaf58d86c66e3abed40b84f9c753322bdfbb737060db08cba93f60a2aba09e73d8384b1e23f6cfbe08c60da64102561d4f731ce071ab1a5349dced89a1849a257aa13d8e5ed9a559eeb6dbe5f6732ef512541b09888beebaae13d50b5d8814587ac0a2da0b29a1d9a1d6245b372fd93cb5083a6422c2ae56c9b640f03d
APPWRITE_DATABASE_ID=insights

# ── Search ────────────────────────────────────────────────────────────
INSIGHTS_SEARCH_BACKEND=tfidf              # or sentence-transformer
INSIGHTS_SEARCH_TOP_K_DEFAULT=5
INSIGHTS_SEARCH_TOP_K_MAX=20
INSIGHTS_SEARCH_MIN_SCORE=0.1
INSIGHTS_SEARCH_CACHE_TTL=300
INSIGHTS_SEARCH_MAX_DOCUMENTS=5000

# ── Audit ─────────────────────────────────────────────────────────────
INSIGHTS_AUDIT_RETENTION_DAYS=30           # applies to both backends
INSIGHTS_AUDIT_BATCH_MAX=100

# ── Auth ──────────────────────────────────────────────────────────────
# Comma-separated list of admin emails - set this to your demo user's email
# to access admin-only dashboard routes
INSIGHTS_ADMIN_EMAILS=your-demo-user@example.com

# Appwrite session secret - used by verification.py to authenticate against
# Appwrite deployments (alternative to TOKEN/JWT)
APPWRITE_SESSION=your_appwrite_session_secret

# ── Feature flags ─────────────────────────────────────────────────────
INSIGHTS_SEED_DEMO=true