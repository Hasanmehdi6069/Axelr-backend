# ── Nebius × NVIDIA Bridge Configuration (required for axelr_nebius_nvidia module) ──
# API Authentication
NEBIUS_API_ENDPOINT=https://api.nebius.ai/v1
NEBIUS_API_KEY=your-nebius-api-key-here

# Multi-Region Configuration
NEBIUS_REGIONS=eu-west-1,us-east-1,ap-southeast-1

# NVIDIA Model Configuration (supported open-source models)
NVIDIA_MODELS=llama3:70b,mistral:8x7b,phi3:14b,gemma2:27b

# Rate Limiting & Concurrency
RATE_LIMIT_TPM=100000
MAX_CONCURRENT_INFERENCES=16
STREAMING_CHUNK_SIZE=4

# NVIDIA TensorRT Optimization
TENSORRT_QUANTIZE=true
GPU_MEMORY_FRACTION=0.9